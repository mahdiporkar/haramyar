# HaramYar gateway (single browser origin). TLS terminates in front of this gateway in production (CapRover/ingress),
# which must send X-Forwarded-Proto and X-Forwarded-Port; they are passed through only when present (local HTTP sends none). Variables in ${...} are filled from the environment at container start.

limit_req_zone $binary_remote_addr zone=haramyar_identity:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=haramyar_api:10m rate=30r/s;
limit_req_status 429;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 8080;
  server_tokens off;
  client_max_body_size 8m;
  root /usr/share/nginx/html;
  resolver ${HARAMYAR_RESOLVER} valid=10s ipv6=off;

  # Upstreams are variables so nginx starts (and keeps serving the shell) while a dependency has no running task yet;
  # the BFF itself needs this gateway for OIDC discovery, so a startup-time lookup would deadlock on first deployment.
  set $bff ${HARAMYAR_BFF_UPSTREAM};
  set $keycloak ${HARAMYAR_KEYCLOAK_UPSTREAM};
  set $public_web ${HARAMYAR_PUBLIC_WEB_UPSTREAM};
  set $console ${HARAMYAR_CONSOLE_UPSTREAM};

  # --- Hive BFF: sessions, CSRF, contexts, dynamic routes and micro-frontend artifacts -------------------------
  # Book PDFs allow 30 MiB plus multipart framing, matching the martyrs service.
  location ~ ^/api/routes/martyrs/editorial/books/editions/[0-9a-f-]+/file$ {
    client_max_body_size 31m;
    limit_req zone=haramyar_api burst=60 nodelay;
    proxy_pass $bff;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    proxy_http_version 1.1;
    proxy_read_timeout 130s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
  }
  location ~ ^/(api|auth|oauth2|login/oauth2)/ {
    limit_req zone=haramyar_api burst=60 nodelay;
    proxy_pass $bff;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    proxy_http_version 1.1;
    proxy_read_timeout 130s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
  }
  location /actuator/ { return 404; }

  # --- Identity provider: only the HaramYar realm's browser endpoints; never the master realm or admin APIs -------
  location ^~ /realms/haramyar/ {
    location ~ ^/realms/haramyar/(login-actions|protocol/openid-connect/(auth|registrations)) {
      limit_req zone=haramyar_identity burst=20 nodelay;
      proxy_pass $keycloak;
      include /etc/nginx/conf.d/keycloak-proxy.inc;
    }
    proxy_pass $keycloak;
    include /etc/nginx/conf.d/keycloak-proxy.inc;
  }
  location ^~ /resources/ { proxy_pass $keycloak; include /etc/nginx/conf.d/keycloak-proxy.inc; }
  location ^~ /realms/ { return 404; }
  location ^~ /admin/realms/ { return 404; }
  location ^~ /admin/master/ { return 404; }

  # --- Hive Operator Console (platform operators only; separate experience) --------------------------------------
  # HARAMYAR_CONSOLE_UPSTREAM=off when the operator console is not deployed in this environment.
  location ^~ /console/ { if ($console = "off") { return 404; } proxy_pass $console; proxy_set_header Host $http_host; proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port; }

  # --- Server-rendered public pages (SEO) --------------------------------------------------------------------------
  location ~ ^/(martyr(/.*)?|sitemap\.xml|robots\.txt)$ {
    proxy_pass $public_web;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Port $http_x_forwarded_port;
    include /etc/nginx/conf.d/security-headers.inc;
  }

  # --- Shell (static) -------------------------------------------------------------------------------------------
  location = /sw.js { add_header Cache-Control "no-cache" always; add_header Service-Worker-Allowed "/" always; include /etc/nginx/conf.d/security-headers.inc; }
  location /static/ { add_header Cache-Control "public, max-age=31536000, immutable" always; include /etc/nginx/conf.d/security-headers.inc; }
  location /assets/ { add_header Cache-Control "public, max-age=86400" always; include /etc/nginx/conf.d/security-headers.inc; try_files $uri =404; }
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/conf.d/security-headers.inc;
  }
}
